# Story genre convertor — configuration.
#
# AUTH: Gemini runs on Vertex AI through Application Default Credentials, same
# as the rest of this repo. There are no API keys. Run once:
#   gcloud auth application-default login
# (and see ../../scripts/gcp_setup.sh to enable services.)
#
# Every value below is optional and shown with its built-in default from llm.py.
# Copy to `.env` (gitignored) only if you need to override something.

# --- GCP / Vertex AI --------------------------------------------------------
GOOGLE_CLOUD_PROJECT=pocketfm-hackathon
# "global" — where this project's gemini-3.x IDs are served (us-central1 has only
# the 2.5 family). Matches the studio backend.
VERTEX_LOCATION=global

# --- Model ------------------------------------------------------------------
# gemini-3.5-flash on "global" — the same model the studio uses everywhere.
# Re-run calibrate.py after switching models; thresholds are model-specific.
GEMINI_MODEL=gemini-3.5-flash

# --- Pivot survival ----------------------------------------------------------
# The in-flight delivery gate votes: a scene passes only when every ballot finds
# each load-bearing beat on the page. 1 disables voting (single check, as before).
DELIVERY_VOTES=2
# Total writes of one scene (first attempt + retries) while a pivot is missing.
MAX_SCENE_ATTEMPTS=3
# Retries and repairs run cool — compliance, not creativity.
RETRY_TEMPERATURE=0.3
# Post-verification repair: patch and re-judge a story/chapter that dropped a
# load-bearing beat, at most this many rounds. 0 disables repair.
REPAIR_ROUNDS=1
