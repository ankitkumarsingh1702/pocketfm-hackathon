# Story genre convertor — configuration.
#
# AUTH: Gemini runs on Vertex AI through Application Default Credentials, same
# as the rest of this repo. There are no API keys. Run once:
#   gcloud auth application-default login
# (and see ../../scripts/gcp_setup.sh to enable services.)
#
# Every value below is optional and shown with its built-in default from llm.py.
# Copy to `.env` (gitignored) only if you need to override something.

# --- GCP / Vertex AI --------------------------------------------------------
GOOGLE_CLOUD_PROJECT=pocketfm-hackathon
VERTEX_LOCATION=us-central1

# --- Model ------------------------------------------------------------------
# Both stages (causal extraction, structural judging) are reasoning tasks where
# a flash-tier model gets sloppy about causal edges — hence pro by default.
# Re-run calibrate.py after switching models; thresholds are model-specific.
GEMINI_MODEL=gemini-3.1-pro-preview
