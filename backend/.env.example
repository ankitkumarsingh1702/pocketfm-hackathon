# Simulated Studio — backend configuration.
#
# Copy this file to `backend/.env` and override only what you need; every value
# below is optional and shown with its built-in default from app/config.py.
#
# AUTH: All GCP access uses Application Default Credentials (ADC). There are NO
# API keys in this repo. Run once:  gcloud auth application-default login
# (and see ../scripts/gcp_setup.sh to enable services + Firestore).

# --- GCP / Vertex AI --------------------------------------------------------
# GCP project that hosts Vertex AI (and Firestore, if enabled).
GOOGLE_CLOUD_PROJECT=pocketfm-hackathon
# Region for Gemini-on-Vertex. Works in most regions incl. us-central1 / "global".
VERTEX_LOCATION=us-central1

# --- LLM provider -----------------------------------------------------------
# "gemini" (default, native to any GCP project) or "claude" (requires the
# Claude models to be enabled in Vertex AI Model Garden).
LLM_PROVIDER=gemini
# Base/fallback Gemini model.
GEMINI_MODEL=gemini-2.5-flash
# Per-lens model tiering (Gemini only): fast for the high-volume audience
# fan-out, a stronger model for the quality-critical Writers Room + rewrite.
MODEL_AUDIENCE=gemini-2.5-flash
MODEL_EXPERTS=gemini-2.5-pro
MODEL_REWRITE=gemini-2.5-pro
# Audience Simulator ("Living Audience") reaction agents — the strongest Gemini,
# since these are genuine multi-step, vision-capable (multimodal) agents.
MODEL_SIM=gemini-2.5-pro
# Claude on Vertex: bare current-gen ID; region-gated + enable in Model Garden.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_LOCATION=us-east5

# --- Generation -------------------------------------------------------------
# Higher temperature => more variety across simulated personas.
TEMPERATURE=0.9
MAX_OUTPUT_TOKENS=8192
# Simultaneous LLM calls in the batch runner.
CONCURRENCY=10

# --- Persistence ------------------------------------------------------------
# Persist each simulation to Firestore. Fails gracefully if unavailable.
USE_FIRESTORE=true
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=simulations
# Local JSON cache of LLM responses (relative to backend/) for instant re-runs.
CACHE_DIR=.cache

# --- Knowledge graph (Neo4j) ------------------------------------------------
# The story "canon" graph — shared, persistent agent memory. Fully optional and
# best-effort: leave NEO4J_URI/NEO4J_PASSWORD blank and the engine runs exactly
# as before (empty canon, no errors). Point NEO4J_URI at a Neo4j Aura instance
# (neo4j+s://xxxx.databases.neo4j.io) or a self-hosted server. In production the
# credentials come from Secret Manager (see scripts/gcp_setup.sh), never here.
USE_GRAPH=true
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Max characters of canon memory injected into a persona/expert prompt.
CANON_MAX_CHARS=2000

# --- Simulation -------------------------------------------------------------
# Audience listeners to fan out to per run. Keep modest for fast/cheap demos.
AUDIENCE_FANOUT=60

# --- Audience Simulator ("Living Audience") ---------------------------------
# Genuine, stateful, multimodal reaction agents. Budget is not the constraint —
# these run wider/deeper than the base audience lens.
SIM_PANEL_DEFAULT=200      # distinct persona-agents per run by default
SIM_PANEL_MAX=2000         # hard cap on a single run's fan-out
SIM_CONCURRENCY=32         # simultaneous reaction agents in flight
SIM_MAX_RETRIES=3          # retries on 429/503 with backoff + jitter
PLANNER_REQUESTS_PER_SECOND=5 # paced starts keep 1,000-agent runs below Vertex quota
PLANNER_MAX_RETRIES=6      # longer quota-aware recovery for planner agents
SIM_AGENTIC=true           # run the multi-step perceive->recall->react loop

# --- API --------------------------------------------------------------------
# Comma-separated list of allowed CORS origins (frontend dev + preview servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
