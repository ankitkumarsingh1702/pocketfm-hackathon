# Base URL of the Simulated Studio backend (FastAPI).
# Copy to `.env` (or `.env.local`) and adjust if the backend runs elsewhere.
VITE_API_URL=http://localhost:8000

# Optional. Where the DB / Memory tab's "Open in Neo4j" arrow points. Normally
# the backend derives this from NEO4J_URI and sends it in /api/canon/health;
# set this only to force the link (e.g. your Aura console) without a redeploy.
# VITE_NEO4J_BROWSER_URL=https://console.neo4j.io/
